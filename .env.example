# Public site URL (used for canonical URLs, sitemap, Open Graph). TODO: replace with the real .com domain.
NEXT_PUBLIC_SITE_URL=https://elevatedtech.example

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=

# Server-side webhook that receives every lead form submission (n8n webhook, Google Apps Script → Sheet, etc.).
# Never exposed to the browser. Leave empty to only log leads on the server.
LEAD_WEBHOOK_URL=

# Show the yellow "TODO" placeholder badges on the page. Set to "false" for clean previews.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true

# El-IAs, the AI receptionist (server-only). Without it the chat politely hands visitors off to WhatsApp.
ANTHROPIC_API_KEY=
